# Copy to .env.local and fill in. .env.local is git-ignored. Never commit it.

# Firebase console > Project settings > Your apps > Web app > Config, as one line of JSON.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# App Check is required by Firebase AI Logic.
# Dev and automated tests: generate a UUID (`uuidgen`), register it in the
# Firebase console under App Check > Apps > Manage debug tokens, and put it here.
VITE_APPCHECK_DEBUG_TOKEN=

# Hosted build only: a reCAPTCHA Enterprise site key. Not needed for local work.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# VITE_CLOUD_MODEL=

# Copy to .env.local and fill in. .env.local is git-ignored.

# Firebase console > Project settings > Your apps > Web app > Config, as one line of JSON.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# App Check (required by Firebase AI Logic). In `npm run dev` a debug token is
# printed to the browser console; register it in the Firebase console.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# VITE_CLOUD_MODEL=
